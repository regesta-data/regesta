{
  "name": "regesta",
  "version": "0.0.0",
  "private": true,
  "description": "Open graph of EU legislative procedures across Commission, Parliament and Council (Module 1, M0 scaffold).",
  "license": "AGPL-3.0-only",
  "author": "Manuel Wechner, trading as Berth (https://regesta.io)",
  "homepage": "https://regesta.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/regesta-data/regesta.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "check:licenses": "node scripts/check-licenses.ts",
    "check:rules": "node scripts/check-rules.ts test/reference-cases test/fixtures",
    "check:paths": "node scripts/check-paths.ts .",
    "check:scancode": "node scripts/scancode-gate.ts scancode-results.json",
    "ci": "npm run typecheck && npm run test && npm run check:licenses && npm run check:rules && npm run check:paths"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
